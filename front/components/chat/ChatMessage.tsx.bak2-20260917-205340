"use client";

import { useState, useRef, useEffect } from 'react';
import { Check, CheckCheck, MoreHorizontal, Reply, Trash2, Smile, FileText, Download } from 'lucide-react';
import { useAuth } from '@/contexts/AuthContext';
import { api } from '@/lib/api';

interface ChatMessageProps {
  id: number;
  sender_id: number;
  message: string;
  is_read: boolean;
  created_at: string;
  read_at?: string;
  onDeleted?: (messageId: number) => void;
  onReply?: (message: { id: number; message: string }) => void;
}

const REACTIONS = ['👍', '❤️', '😂', '😮', '😢', '🤝','😊','🤓','😢','😭','👋','👊','🙏','🤧','🤒','🙁'];

export function ChatMessage({ id, sender_id, message, is_read, created_at, read_at, onDeleted, onReply }: ChatMessageProps) {
  const { user } = useAuth();
  const isOwn = sender_id === user?.id;
  const isImage = message.startsWith('[IMAGE]');
  const imageData = isImage ? message.slice(7) : null;

  // 🔥 Documento anexado: formato [DOC:nome_do_arquivo.pdf]<base64...>
  const isDoc = message.startsWith('[DOC:');
  const docFilename = isDoc ? message.slice(5, message.indexOf(']')) : null;
  const docData = isDoc ? message.slice(message.indexOf(']') + 1) : null;

  const [menuOpen, setMenuOpen] = useState(false);
  const [reactionOpen, setReactionOpen] = useState(false);
  const [deleting, setDeleting] = useState(false);
  const [deleted, setDeleted] = useState(false);
  const menuRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    if (!menuOpen && !reactionOpen) return;
    const handleClick = (e: MouseEvent) => {
      if (menuRef.current && !menuRef.current.contains(e.target as Node)) {
        setMenuOpen(false);
        setReactionOpen(false);
      }
    };
    document.addEventListener('mousedown', handleClick);
    return () => document.removeEventListener('mousedown', handleClick);
  }, [menuOpen, reactionOpen]);

  const handleDelete = async () => {
    if (deleting) return;
    setDeleting(true);
    try {
      await api(`/api/chat/messages/${id}`, { method: 'DELETE' });
      setDeleted(true);
      onDeleted?.(id);
    } catch (err) {
      console.error('Erro ao apagar mensagem:', err);
    } finally {
      setDeleting(false);
      setMenuOpen(false);
    }
  };

  const handleReply = () => {
    onReply?.({ id, message });
    setMenuOpen(false);
  };

  const formatMessageTime = (dateStr: string) => {
    return new Date(dateStr).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  };

  if (deleted) {
    return (
      <div className={`flex ${isOwn ? 'justify-end' : 'justify-start'} mb-2`}>
        <div className="text-xs text-gray-400 italic px-4 py-2">Mensagem apagada</div>
      </div>
    );
  }

  return (
    <div className={`flex ${isOwn ? 'justify-end' : 'justify-start'} mb-2 group`}>
      <div className={`relative max-w-[75%] ${isOwn ? 'items-end' : 'items-start'} flex flex-col`}>
        <div
          className={`rounded-2xl px-4 py-2.5 relative ${
            isOwn
              ? 'bg-[#E03673] text-white rounded-br-sm'
              : 'bg-gray-100 text-gray-800 rounded-bl-sm'
          }`}
        >
          {isImage && imageData ? (
            <img
              src={imageData}
              alt="Imagem enviada"
              className="rounded-lg max-w-full max-h-64 cursor-pointer"
              onClick={() => window.open(imageData, '_blank')}
            />
          ) : isDoc && docData ? (
            <a
              href={docData}
              download={docFilename || 'documento'}
              className={`flex items-center gap-2.5 px-1 py-1 rounded-lg transition-colors ${
                isOwn ? 'hover:bg-white/10' : 'hover:bg-gray-200'
              }`}
            >
              <div className={`w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0 ${isOwn ? 'bg-white/20' : 'bg-white'}`}>
                <FileText className={`w-4 h-4 ${isOwn ? 'text-white' : 'text-[#E03673]'}`} />
              </div>
              <span className="text-sm truncate max-w-[160px]">{docFilename || 'Documento'}</span>
              <Download className="w-3.5 h-3.5 flex-shrink-0 opacity-70" />
            </a>
          ) : (
            <p className="text-sm whitespace-pre-wrap break-words">{message}</p>
          )}

          <button
            onClick={() => setMenuOpen(v => !v)}
            className={`absolute -top-2 ${isOwn ? '-left-8' : '-right-8'} opacity-0 group-hover:opacity-100 transition-opacity p-1 rounded-full hover:bg-gray-100 bg-white shadow-sm border border-gray-100`}
          >
            <MoreHorizontal className="w-3.5 h-3.5 text-gray-500" />
          </button>

          {menuOpen && (
            <div
              ref={menuRef}
              className={`absolute top-6 ${isOwn ? 'right-0' : 'left-0'} z-20 bg-white rounded-lg shadow-lg border border-gray-200 py-1 w-40 text-left`}
            >
              <button
                onClick={handleReply}
                className="w-full flex items-center gap-2 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50"
              >
                <Reply className="w-3.5 h-3.5" />
                Responder
              </button>
              <button
                onClick={() => { setReactionOpen(true); setMenuOpen(false); }}
                className="w-full flex items-center gap-2 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50"
              >
                <Smile className="w-3.5 h-3.5" />
                Reagir
              </button>
              {isOwn && (
                <button
                  onClick={handleDelete}
                  disabled={deleting}
                  className="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-600 hover:bg-red-50 disabled:opacity-50"
                >
                  <Trash2 className="w-3.5 h-3.5" />
                  Apagar
                </button>
              )}
            </div>
          )}

          {reactionOpen && (
            <div
              ref={menuRef}
              className={`absolute top-6 ${isOwn ? 'right-0' : 'left-0'} z-20 bg-white rounded-lg shadow-lg border border-gray-200 p-2 grid grid-cols-8 gap-1 w-64`}
            >
              {REACTIONS.map(r => (
                <button key={r} onClick={() => setReactionOpen(false)} className="text-lg hover:bg-gray-100 rounded p-1">
                  {r}
                </button>
              ))}
            </div>
          )}
        </div>

        <div className={`flex items-center gap-1 mt-1 px-1 ${isOwn ? 'flex-row-reverse' : ''}`}>
          <span className="text-[10px] text-gray-400">{formatMessageTime(created_at)}</span>
          {isOwn && (
            is_read
              ? <CheckCheck className="w-3.5 h-3.5 text-[#2F80D3]" />
              : <Check className="w-3.5 h-3.5 text-gray-400" />
          )}
        </div>
      </div>
    </div>
  );
}
